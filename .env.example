# Copy this file to .env and fill in the values:
#   cp .env.example .env

# --- Database (PostgreSQL) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cloudflow
DATABASE_USER=cloudflow
DATABASE_PASSWORD=change-me
DATABASE_SSLMODE=disable

# --- API server ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# dev  -> human-readable logs to stdout (debug level)
# prod -> JSON logs (warn level), to LOG_PATH if set
LOG_TYPE=dev
LOG_PATH=

# --- Auth ---
# Generate a strong secret, e.g.: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=24h

# --- SMTP (optional, required only for email OTP login) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="CloudFlow <no-reply@example.com>"

# --- Integration tests (optional) ---
# Name of the disposable database created by scripts/test-integration.sh.
TEST_DB=cloudflow_test

# Name of an already-running PostgreSQL container to reuse instead of
# starting one from docker-compose.dev.yml. Leave unset for the default.
POSTGRES_CONTAINER=
