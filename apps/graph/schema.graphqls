# GraphQL schema example
#
# https://gqlgen.com/getting-started/

type User {
    id: ID!
    name: String!
    email: String!
    img_user: String
    role: String
    rating: Int
    balance: Float # numeric в БД
    created_at: String
    updated_at: String
}

type Product {
    id: ID!
    seller_id: ID!
    category_id: Int
    name: String!
    description: String!
    price: Float! # numeric в БД
    rating: Int # integer в БД
    status: String
    tags: [String] # Потребует JOIN при запросе
    created_at: String!
    updated_at: String!
}

type Order {
    id: ID!
    buyer_id: ID!
    status: String!
    total_amount: Float!
    created_at: String
    updated_at: String
}

type Category {
    id: Int!
    name: String!
    parent_id: Int
}

type OrderItem {
    id: ID!
    orderID: ID!
    productID: ID!
    price_at_purchase: Int!
}

type Query {
    getUsers(name: String, email: String, id: ID): [User]
    getProducts(name: String, id: ID, seller_id: ID): [Product]
    getOrders(buyer_id: ID, status: String): [Order]
    getCategories: [Category]
}

type Mutation {
    setUser(
        name: String!
        email: String!
        img_user: String!
        password: String!
    ): User
    setProduct(
        sellerID: ID!
        categoryID: Int!
        name: String!
        description: String!
        price: Int!
        rating: Float!
        tags: [String]!
    ): Product
    setCategory(name: String!, parentID: Int): Category
}
